+// chitin: Screeps replaces the global `Memory` every tick (vanilla redefines it
+// as an accessor, players' memhack deletes and reassigns it), and replacing a
+// global's cell deoptimizes all code compiled against it. Its accesses stay on
+// the global IC, which follows the new cell without a deopt.
+static bool IsChitinVolatileGlobal(compiler::PropertyCellRef cell,
+                                   compiler::JSHeapBroker* broker) {
+  Tagged<Name> name = cell.object()->name();
+  return IsString(name) &&
+         Cast<String>(name)->IsEqualTo(base::StaticCharVector("Memory"),
+                                       broker->local_isolate_or_isolate());
+}
